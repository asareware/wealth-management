# Plaid (https://dashboard.plaid.com) - free Trial plan, up to 10 connections
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# AI assistant (https://console.anthropic.com) - optional
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Your database and statements. Keep this OUT of OneDrive/iCloud so your financial data stays on this computer.
# Default: ~/WealthPortalData on your computer, /home/data on Azure App Service.
# WEALTH_DATA_DIR=~/WealthPortalData

# Leave these commented out. The app picks the right values itself:
#   on your computer: 127.0.0.1:8765 (only your computer can reach it)
#   on Azure App Service: 0.0.0.0:8000 (only App Service's sign-in front end can reach it)
# HOST=127.0.0.1
# PORT=8765

# Encrypts Plaid access tokens in the database. Required on Azure (stored in Key Vault).
# Locally, leave it empty and a key file is created in your data folder. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key means reconnecting every bank.
TOKEN_ENCRYPTION_KEY=

# Sign-in check. On Azure it's on automatically; locally it's off.
# ALLOWED_USERS: your Entra ID object ID (preferred) and/or sign-in email, comma-separated.
# REQUIRE_SIGN_IN=false
# ALLOWED_USERS=
