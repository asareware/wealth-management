# Plaid (https://dashboard.plaid.com) - free Trial plan, up to 10 connections
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# AI assistant (https://console.anthropic.com) - optional
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Your database and statements. Keep this OUT of OneDrive/iCloud so your financial data stays on this Mac.
WEALTH_DATA_DIR=~/WealthPortalData

# Keep this as 127.0.0.1 so only your computer can reach the portal
HOST=127.0.0.1
PORT=8765
